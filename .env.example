# Measured RAG - environment variables (copy to .env, never commit secrets)

# PostgreSQL + pgvector
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=measured_rag
POSTGRES_USER=measured_rag
POSTGRES_PASSWORD=change_me

# SQLAlchemy URL (optional override; if empty, built from POSTGRES_* above)
# DATABASE_URL=postgresql+psycopg://measured_rag:change_me@localhost:5432/measured_rag

# Embeddings (local, CPU-friendly default)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=16
EMBEDDING_NORMALIZE=true
EMBEDDING_CACHE_ENABLED=true

# Chunking (baseline fixed)
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# Retrieval
TOP_K=5

# Generation
GENERATION_TIMEOUT_S=60

# LLM provider: ollama (default, local) or openai_compat (optional, external)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Optional external OpenAI-compatible provider (leave unset for local-only)
# OPENAI_COMPAT_BASE_URL=
# OPENAI_COMPAT_API_KEY=
# OPENAI_COMPAT_MODEL=

# App
APP_ENV=development
LOG_LEVEL=INFO
DATA_DIR=./data
CONFIG_DIR=./configs
CACHE_DIR=./.cache
SEED=42
MAX_TOP_N_RERANK=20
RRF_K=60
